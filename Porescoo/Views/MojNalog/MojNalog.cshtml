               text-align: center !important;
          }

          .text-right {
               text-align: right !important;
          }

          .text-uppercase {
               text-transform: uppercase;
          }

          .datum-kockice-wrapper {
               display: block !important;
               white-space: nowrap !important;
               text-align: center;
               width: 100%;
               box-sizing: border-box;
          }

          .kockica {
               display: inline-block !important;
               width: 11px;
               height: 14px;
               border: 1px solid #000;
               text-align: center;
               line-height: 14px;
               font-weight: normal;
               font-size: 9px;
               margin: 0 !important;
               padding: 0 !important;
               background: #fff;
               border-right: none;
          }

          .kockica:last-of-type {
               border-right: 1px solid #000 !important;
          }

          .kockica-prazna {
               display: inline-block !important;
               width: 11px;
               height: 14px;
               border: 1px solid #000;
               margin: 0 !important;
               padding: 0 !important;
               background: #fff;
               border-right: none;
          }

          .kockica-prazna:last-of-type {
               border-right: 1px solid #000 !important;
          }

          .kockica-h {
               display: inline-block;
               width: 25px;
               height: 14px;
               border: 1px solid #000;
               margin: 0 auto;
