          }

          .sub-label {
               display: block !important;
               font-size: 6px;
               text-align: center;
               color: #000;
               margin-top: 1px;
               font-family: Arial, sans-serif;
               letter-spacing: 0px;
          }

          .linija-tekst {
               border-bottom: 1px solid #000;
               font-weight: normal;
               font-size: 10px;
               padding-left: 8px !important;
          }

          .linija-polje-tabela {
               display: block;
               width: 90%;
               border-bottom: 1px solid #000;
