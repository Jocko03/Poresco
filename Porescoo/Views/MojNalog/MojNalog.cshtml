          @@page {
               margin: 0.3cm !important;
          }

          .no-print {
               display: none !important;
          }

          html, body {
               background: #fff;
               color: #000;
               font-family: "Arial", sans-serif;
               margin: 0;
               padding: 0;
          }

          .print-only {
               display: block !important;
               position: relative;
               width: 100%;
               padding: 0px;
          }

          .gov-section-title {
               font-size: 10px;
               font-weight: bold;
               background-color: #ffffff !important;
               border: 1px solid #000;
               padding: 2px 4px;
               margin-top: 6px;
               margin-bottom: -1px;
               -webkit-print-color-adjust: exact;
               print-color-adjust: exact;
          }

          .gov-table {
               width: 100%;
               border-collapse: collapse;
               margin-bottom: 3px;
               table-layout: fixed;
          }

          .gov-table th, .gov-table td {
               border: 1px solid #000;
               padding: 2px 3px;
               font-size: 9px;
               vertical-align: middle;
          }

          .gov-table th {
               font-size: 8px;
               background-color: #ffffff !important;
               font-weight: normal;
