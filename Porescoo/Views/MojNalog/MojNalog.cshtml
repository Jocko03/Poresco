@model _1_SlojPodataka.Modeli.PoreskiObveznikModel
@{
     Layout = null; // POTPUNO UKLANJA HEADER, FOOTER I NAVIGACIJU SA OVE STRANICE
}

<!DOCTYPE html>
<html>
<head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <title>Moj Nalog - PPDG-3R</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

     <div class="container mt-4 no-print">
          @* ==========================================
               GLAVNA JEDINSTVENA FORMA (UNOS / IZMENA)
               ========================================== *@
          <div class="card p-3 mb-4 bg-light shadow-sm border-primary" id="glavnaKarticaForme">
               <h5 id="naslovForme" class="text-primary">Unos novog obveznika</h5>
               @using (Html.BeginForm("SacuvajSve", "MojNalog", FormMethod.Post, new { id = "masterForm" }))
               {
                    <div class="row g-3">
                         <div class="col-md-3">@Html.TextBoxFor(m => m.Ime, new { @class = "form-control", placeholder = "Ime", id = "txtIme" })</div>
                         <div class="col-md-3">@Html.TextBoxFor(m => m.Prezime, new { @class = "form-control", placeholder = "Prezime", id = "txtPrezime" })</div>
                         <div class="col-md-3">@Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email", id = "txtEmail" })</div>
                         <div class="col-md-3">@Html.TextBoxFor(m => m.JMBG, new { @class = "form-control", placeholder = "JMBG", id = "txtJMBG" })</div>
                         <div class="col-md-3">@Html.TextBoxFor(m => m.Opstina, new { @class = "form-control", placeholder = "Opština", id = "txtOpstina" })</div>
                         <div class="col-md-3">@Html.TextBoxFor(m => m.Adresa, new { @class = "form-control", placeholder = "Adresa", id = "txtAdresa" })</div>
                         <div class="col-md-2">@Html.TextBoxFor(m => m.Broj, new { @class = "form-control", placeholder = "Broj", id = "txtBroj" })</div>
                         <div class="col-md-4">@Html.TextBoxFor(m => m.BrojTelefona, new { @class = "form-control", placeholder = "Telefon", id = "txtTelefon" })</div>
                         <div class="col-md-6">@Html.TextBoxFor(m => m.Drzava, new { @class = "form-control", placeholder = "Država", id = "txtDrzava" })</div>
                         <div class="col-md-6">@Html.TextBoxFor(m => m.JmbgPoreskogPunomocnika, new { @class = "form-control", placeholder = "JMBG Punomoćnika", id = "txtPunomocnik" })</div>
                    </div>

                    <h5 class="mt-4">Transakcije (Akcije)</h5>
                    <div id="transakcije-kontejner">
                         <div class="row g-2 mb-2 transakcija-red" id="prvi-red">
                              <div class="col-md-2"><input type="text" class="form-control" placeholder="Naziv akcije" oninput="izracunajPorez()" /></div>
                              <div class="col-md-2"><input type="text" class="form-control" placeholder="DD.MM.YYYY" oninput="izracunajPorez()" /></div>
                              <div class="col-md-3"><input type="number" step="any" class="form-control" placeholder="Prodajna cena" oninput="izracunajPorez()" /></div>
                              <div class="col-md-2"><input type="text" class="form-control" placeholder="DD.MM.YYYY" oninput="izracunajPorez()" /></div>
                              <div class="col-md-3"><input type="number" step="any" class="form-control" placeholder="Nabavna cena" oninput="izracunajPorez()" /></div>
                         </div>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                         <button type="button" class="btn btn-outline-success btn-sm" onclick="dodajRed()">+ Dodaj red</button>
                         <button type="button" id="btnResetuj" class="btn btn-outline-secondary btn-sm d-none" onclick="resetujFormuNaUnos()">Nazad na unos novog</button>
                    </div>

                    <div class="card p-3 mb-3 bg-dark text-white shadow-sm">
                         <div class="row">
                              <div class="col-md-6"><h5>Ukupni Kapitalni Balans: <span id="txtUkupniDobitak">0.00</span></h5></div>
                              <div class="col-md-6 text-end"><h5>Porez za plaćanje (15%): <span id="txtIznosPoreza" class="text-warning">0.00</span> RSD</h5></div>
                         </div>
                    </div>

                    <div class="d-flex gap-2">
                         <button type="submit" id="btnGlavnaAkcija" class="btn btn-primary">SAČUVAJ NOVI NALOG</button>
                         <button type="button" id="btnStampaj" class="btn btn-secondary" onclick="pokreniStampu()">🖨️ ŠTAMPAJ PPDG-3R</button>
                    </div>
               }
          </div>

          <hr />

          <h4>Lista obveznika</h4>
          <input type="text" id="filterInput" class="form-control mb-3" placeholder="Pretraži..." onkeyup="filtriraj()">

          <div class="list-group mb-4" id="listaObveznika">
          </div>
     </div>

     @* =========================================================================
          VERNA REPRODUKCIJA OBRASCA PPDG-3R
          ========================================================================= *@
     <div id="izvestajZaStampu" class="print-only">
          <table style="width: 100%; border: none; margin-bottom: 3px;">
               <tr>
                    <td style="border: none; font-size: 10px; font-weight: bold; padding: 0;">Пореска пријава за утврђивање пореза на капиталне добитке</td>
                    <td style="border: none; text-align: right; font-size: 10px; font-weight: bold; padding: 0;">Образац ППДГ-3Р</td>
               </tr>
          </table>

          <div class="gov-section-title">Део 1. Подаци о пријави</div>
          <table class="gov-table text-center table-fixed">
               <thead>
                    <tr>
                         <th style="width: 10%;">1.1 Врста пријаве</th>
                         <th style="width: 10%;">1.1а Основ за пријаву</th>
                         <th style="width: 26%;">1.2 Датум остваривања прихода/дела прихода</th>
                         <th style="width: 26%;">1.3 Датум доспелости за подношење пореске пријаве</th>
                         <th style="width: 18%;">1.4 Датум и начин подношења пријаве</th>
                         <th style="width: 10%;">1.5 Измена</th>
                    </tr>
               </thead>
               <tbody>
                    <tr style="height: 36px;">
                         <td><span class="kockica">1</span></td>
                         <td><span class="kockica">6</span></td>
                         <td id="lblDatumOstvarivanja" style="padding: 2px 1px !important;"></td>
                         <td id="lblDatumDospelosti" style="padding: 2px 1px !important;"></td>
                         <td id="lblDatumPodnosenja" style="padding: 2px 1px !important;"></td>
                         <td><div class="kockica-h"></div></td>
                    </tr>
               </tbody>
          </table>

          <div class="gov-section-title">Део 2. Подаци о пореском обвезнику</div>
          <table class="gov-table format-rows">
               <tr>
                    <td style="width: 40%;">2.1 Тип пореског обвезnika</td>
                    <td class="linija-tekst" style="font-weight: bold;">11 - резидент физичко лице</td>
               </tr>
               <tr>
                    <td>2.2 Порески идентификациони број (ЈМБГ/ЕБС/ПИБ)</td>
                    <td id="lblPrintJMBG" class="kockice-td font-courier"></td>
               </tr>
               <tr>
                    <td>2.3 Име и презиме пореског обвезника</td>
                    <td id="lblPrintImePrezime" class="linija-tekst text-uppercase"></td>
               </tr>
               <tr>
                    <td>2.4 Пребивалиште/боравиште/седиште/општина остваривања прихода</td>
                    <td id="lblPrintOpstina" class="linija-tekst"></td>
               </tr>
               <tr>
                    <td>2.5 Адреса пореског обvezника</td>
                    <td id="lblPrintAdresa" class="linija-tekst"></td>
               </tr>
               <tr>
                    <td>2.6 Телефон</td>
                    <td id="lblPrintTelefon" class="linija-tekst"></td>
               </tr>
               <tr>
                    <td>2.7 Електронска адреса</td>
                    <td id="lblPrintEmail" class="linija-tekst" style="text-transform: none;"></td>
               </tr>
               <tr>
                    <td>2.8 ЈМБГ подносиоца пријаве</td>
                    <td id="lblPrintJmbgPodnosioca" class="kockice-td font-courier"></td>
               </tr>
               <tr>
                    <td>2.9 Земља резидентства</td>
                    <td id="lblPrintDrzava" class="linija-tekst"></td>
               </tr>
               <tr>
                    <td>2.10 ЈМБГ/ПИБ пореског пуномоћника</td>
                    <td id="lblPrintPunomocnik" class="kockice-td font-courier"></td>
               </tr>
          </table>

          <div class="gov-section-title">Део 3. Подаци за утврђивање пореза код преноса права/удела/дигиталне имовине</div>
          <table class="gov-table table-fixed">
               <thead>
                    <tr>
                         <th style="width: 8%; text-align: center;">3.1 Редни број</th>
                         <th style="width: 23%; text-align: center;">3.2 Датум преноса</th>
                         <th style="width: 25%; text-align: center;">3.3 Продајна цена</th>
                         <th style="width: 24%; text-align: center;">3.4 Датум стицања</th>
                         <th style="width: 20%; text-align: center;">3.5 Набавна цена</th>
                    </tr>
               </thead>
               <tbody id="printTransakcijeBody">
               </tbody>
          </table>
     </div>

     <style>
     .print-only {
          display: none !important;
     }

