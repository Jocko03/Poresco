@model _1_SlojPodataka.Modeli.KorisnikModel

@{
     ViewBag.Title = "Registracija - Poresco";
}
<div class="container my-5">
     <div class="row justify-content-center">
          <div class="col-md-6 col-lg-5">
               <div class="card shadow border-0 rounded-3">
                    <div class="card-body p-5">
                         <div class="text-center mb-4">
                              <div class="display-4 text-primary mb-2">👤</div>
                              <h2 class="fw-bold">Kreiraj nalog</h2>
                              <p class="text-muted">Postanite deo Poresco zajednice</p>
                         </div>

                         @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                         <form action="@Url.Action("Registracija", "Nalog")" method="post">
                              @Html.AntiForgeryToken()

                              <div class="mb-3">
                                   <label for="username" class="form-label small fw-bold text-uppercase">Korisničko ime</label>
                                   <input type="text" class="form-control form-control-lg bg-light" id="username" name="KorisnickoIme" required>
                              </div>

                              <div class="mb-3">
                                   <label for="email" class="form-label small fw-bold text-uppercase">Email adresa</label>
                                   <input type="email" class="form-control form-control-lg bg-light" id="email" name="Email" required>
                              </div>

                              <div class="mb-3">
                                   <label for="password" class="form-label small fw-bold text-uppercase">Lozinka</label>
                                   <input type="password" class="form-control form-control-lg bg-light" id="password" name="Lozinka" required>
                              </div>

                              
                              <div class="mb-4">
                                   <label for="confirmPassword" class="form-label small fw-bold text-uppercase">Potvrdi lozinku</label>
                                   <input type="password" class="form-control form-control-lg bg-light" id="confirmPassword" name="PotvrdaLozinke" required>
                              </div>

                              <div class="d-grid gap-2">
                                   <button type="submit" class="btn btn-primary btn-lg shadow-sm">Registruj se</button>
                              </div>
                         </form>
                    </div>
               </div>
          </div>
     </div>
</div>