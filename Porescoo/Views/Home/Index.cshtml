@{
     ViewBag.Title = "Poresko Izračunavanje - Početna";
     Layout = null;
}

<!DOCTYPE html>
<html>
<head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <title>@ViewBag.Title</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
     <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>

     <div class="container my-5">
          <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
               <div class="container-fluid py-5 text-center">
                    <div class="display-1 mb-4 text-primary"></div>
                    <h1 class="display-5 fw-bold text-dark">Dobrodošli u Poresco</h1>
                    <p class="col-md-8 fs-4 mx-auto text-muted">
                         Vaš pouzdan partner za brzo, precizno i jednostavno izračunavanje svih vrsta poreza. Štedimo vaše vreme i novac.
                    </p>
               </div>
          </div>
     </div>

     <div class="container my-5" id="saznaj-vise">
          <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">

               <div class="col d-flex align-items-start">
                    <div class="icon-square text-bg-light d-inline-flex align-items-center justify-content-center fs-4 flex-shrink-0 me-3 rounded-circle border p-3 text-primary">
                         <i class="bi bi-speedometer2"></i>
                    </div>
                    <div>
                         <h3 class="fw-bold fs-2 text-dark">Brzi proračuni</h3>
                         <p class="text-muted">Unesite osnovne podatke i dobijte kompletan izveštaj o porezu for manje od jednog minuta. Nema više čekanja.</p>
                    </div>
               </div>

               <div class="col d-flex align-items-start">
                    <div class="icon-square text-bg-light d-inline-flex align-items-center justify-content-center fs-4 flex-shrink-0 me-3 rounded-circle border p-3 text-success">
                         <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                         <h3 class="fw-bold fs-2 text-dark">Garantovana tačnost</h3>
                         <p class="text-muted">Naša matematika je uvek usklađena sa najnovijim zakonskim propisima i stopama. Bezbednost na prvom mestu.</p>
                    </div>
               </div>

               <div class="col d-flex align-items-start">
                    <div class="icon-square text-bg-light d-inline-flex align-items-center justify-content-center fs-4 flex-shrink-0 me-3 rounded-circle border p-3 text-warning">
                         <i class="bi bi-laptop"></i>
                    </div>
                    <div>
                         <h3 class="fw-bold fs-2 text-dark">Uvek dostupno</h3>
                         <p class="text-muted">Pristupite kalkulatoru sa bilo kog uređaja – računara, tableta ili telefona. Vaši podaci su uvek uz vas.</p>
                    </div>
               </div>
          </div>
     </div>

     <div class="bg-dark text-secondary px-4 py-5 text-center mt-5 rounded">
          <div class="py-5">
               <h1 class="display-5 fw-bold text-white">Spremni da preuzmete kontrolu?</h1>
               <div class="col-lg-6 mx-auto">
                    <p class="fs-5 mb-4">Ulogujte se kako biste sačuvali vaše proračune, pristupili istoriji i dobili personalizovane savete.</p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                         <a href="@Url.Action("Prijava", "Nalog")" class="btn btn-outline-info btn-lg px-4 me-sm-3 fw-bold">
                              <i class="bi bi-person-lock me-2"></i> Prijavi se / Uloguj se
                         </a>
                    </div>
               </div>
          </div>
     </div>

     <style>
          .icon-square {
               width: 3rem;
               height: 3rem;
          }
     </style>

</body>
</html>